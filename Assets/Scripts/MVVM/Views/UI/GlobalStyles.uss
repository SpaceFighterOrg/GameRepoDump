.screen-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.card {
    width: 88%;
    max-width: 160px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(13, 27, 46);
    border-color: rgb(30, 58, 95);
    border-width: 1px;
    border-radius: 8px;
    align-items: center;
}

.auth-card {
    flex-direction: row;
    width: 90%;
    max-width: 400px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(13, 27, 46);
    border-color: rgb(30, 58, 95);
    border-width: 1px;
    border-radius: 8px;
}

.auth-brand {
    flex: 0 0 110px;
    align-items: center;
    justify-content: center;
    padding-right: 12px;
    border-right-color: rgb(30, 58, 95);
    border-right-width: 1px;
    margin-right: 12px;
}

.auth-form {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.title {
    font-size: 13px;
    color: rgb(126, 200, 227);
    -unity-font-style: bold;
    margin-bottom: 2px;
    letter-spacing: 2px;
    -unity-text-align: upper-center;
}

.subtitle {
    font-size: 9px;
    color: rgb(74, 111, 165);
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.field {
    width: 100%;
    margin-bottom: 5px;
}

.field--last {
    margin-bottom: 8px;
}

.primary-button {
    width: 100%;
    height: 22px;
    background-color: rgb(26, 58, 110);
    border-color: rgb(126, 200, 227);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(126, 200, 227);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.secondary-button {
    width: 100%;
    height: 22px;
    background-color: rgb(80, 20, 20);
    border-color: rgb(224, 92, 92);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(224, 92, 92);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.error-label {
    color: rgb(224, 92, 92);
    font-size: 10px;
    display: none;
}

.nav-link {
    font-size: 11px;
    color: rgb(74, 164, 165);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.faction-picker-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 10px;
}

.faction-icon {
    width: 26px;
    height: 26px;
    background-size: contain;
    background-position: center;
}
