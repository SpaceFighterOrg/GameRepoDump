.leaderboard-panel {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    flex-grow: 1;
    padding: 4px;
}

.leaderboard-title {
    font-size: 13px;
    color: rgb(126, 200, 227);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 6px;
    -unity-text-align: upper-center;
}

.factions-row {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    width: 100%;
}

.faction-column {
    flex: 1;
    flex-direction: column;
    align-items: center;
    margin-left: 2%;
    margin-right: 2%;
    background-color: rgb(10, 20, 38);
    border-color: rgb(30, 58, 95);
    border-width: 1px;
    border-radius: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 7px;
    padding-right: 7px;
}

.faction-logo {
    width: 36px;
    height: 36px;
    background-size: contain;
    background-position: center;
    margin-bottom: 4px;
}

.faction-name {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 5px;
    -unity-text-align: upper-center;
}

.faction-name--cartel     { color: rgb(220, 70,  70);  }
.faction-name--coalition  { color: rgb(80,  170, 220); }
.faction-name--mandate    { color: rgb(210, 165, 40);  }

.faction-divider {
    width: 100%;
    height: 1px;
    background-color: rgb(30, 58, 95);
    margin-bottom: 6px;
}

.player-entry {
    width: 100%;
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
    margin-bottom: 4px;
    background-color: rgb(16, 30, 54);
    border-color: rgb(30, 58, 95);
    border-width: 1px;
    border-radius: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
}

.player-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.rank-badge {
    font-size: 9px;
    -unity-font-style: bold;
    width: 16px;
    -unity-text-align: middle-left;
    margin-right: 4px;
}

.rank-badge--gold   { color: rgb(255, 200, 50);  }
.rank-badge--silver { color: rgb(180, 180, 195); }
.rank-badge--bronze { color: rgb(190, 110, 55);  }

.player-name {
    font-size: 9px;
    color: rgb(126, 200, 227);
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-cell {
    width: 50%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.stat-cell-label {
    font-size: 9px;
    color: rgb(74, 111, 165);
    letter-spacing: 1px;
    margin-right: 2px;
    min-width: 24px;
}

.stat-cell-value {
    font-size: 9px;
    color: rgb(160, 210, 235);
    -unity-font-style: bold;
}
